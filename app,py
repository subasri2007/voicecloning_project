from flask import Flask, request, send_file, jsonify
from TTS.api import TTS
import tempfile

app = Flask(__name__)

# Load YourTTS model once when server starts
tts = TTS(model_name="tts_models/multilingual/multi-dataset/your_tts")

@app.route("/generate", methods=["POST"])
def generate_audio():
    voice_file = request.files.get("voice")
    text = request.form.get("text")
    permission = request.form.get("permission")

    # Ethical permission check
    if permission != "on":
        return jsonify({"error": "You must confirm permission to use this voice"}), 400

    # Save uploaded voice temporarily
    tmp_input = tempfile.NamedTemporaryFile(suffix=".wav", delete=False)
    tmp_input.write(voice_file.read())
    tmp_input.flush()

    # Generate audio in uploaded voice
    tmp_output = tempfile.NamedTemporaryFile(suffix=".wav", delete=False)
    tts.tts_to_file(text=text, speaker_wav=tmp_input.name, file_path=tmp_output.name)

    return send_file(tmp_output.name, mimetype="audio/wav")

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)
    